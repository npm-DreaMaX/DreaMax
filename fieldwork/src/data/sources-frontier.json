    ],
    "evidence": "源码观察",
    "file": "modeling_kimi_linear.py",
    "symbol": "_apply_attn_res / KimiDeltaAttention.forward",
    "localPath": "research/frontier/moonshotai--Kimi-K3/modeling_kimi_linear.py",
    "rawUrl": "https://huggingface.co/moonshotai/Kimi-K3/resolve/f831ab66814297da540d832a5235f8e904f29d06/modeling_kimi_linear.py",
    "excerpt": "def _apply_attn_res(prefix_sum, block_residual, proj, norm):\n    \"\"\"\n    prefix_sum:     (num_tokens, hidden_size)\n    block_residual: (num_tokens, num_blocks, hidden_size)\n    \"\"\"\n    v = torch.cat((block_residual, prefix_sum.unsqueeze(1)), dim=1)\n    v_float = v.float()\n    variance = v_float.pow(2).mean(-1, keepdim=True)\n    k = v_float * torch.rsqrt(variance + norm.variance_epsilon)\n    score_weight = norm.weight.float() * proj.weight.squeeze(0).float()\n    scores = (k * score_weight).sum(-1)\n    probs = scores.softmax(-1).unsqueeze(1)\n    hidden_states = torch.matmul(probs, v_float).squeeze(1)\n    return hidden_states.to(v.dtype)",
    "excerptStart": 1075,
    "callChain": "KimiLinearModel → KimiDecoderLayer._forward_attn_residual → _apply_attn_res；self_attn → KimiDeltaAttention.forward → chunk_kda/fused_recurrent_kda",
    "inputOutput": "prefix_sum [T,H]、block_residual [T,N,H]→输出[T,H]；KDA输入[B,S,H]并更新recurrent cache。",
    "notes": "官方模型定义／推理实现；此文件能前向或计算loss，不等于发布了生成该checkpoint的完整预训练与RL流水线。"
