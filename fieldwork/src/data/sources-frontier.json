  {
    "id": "kimi-k3-code",
    "title": "Kimi K3：Attention Residuals与KDA模式分派",
    "organization": "moonshotai",
    "type": "官方源码",
    "url": "https://huggingface.co/moonshotai/Kimi-K3/blob/f831ab66814297da540d832a5235f8e904f29d06/modeling_kimi_linear.py#L1075",
