{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "fieldwork/tests",
    "fieldwork/scripts",
    "src/pages/tools/*/index.astro",
    "src/pages/share.astro",
    "src/components/ui/ClickEffect.astro",
    "src/components/ui/DynamicBackground.astro",
    "src/components/ui/TerminalSlogan.astro"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
