{
  "name": "drea-max-site",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:web": "playwright test",
    "test:labs": "cd fieldwork && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:unit": "vitest run fieldwork/tests/unit.test.ts",
    "check:types": "astro check",
    "check:content": "node scripts/check-integration.mjs",
    "format": "prettier --write src fieldwork/src astro.config.mjs tests scripts *.json *.ts *.md",
    "check": "npm run check:content && npm run test:unit && npm run test:labs && npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
