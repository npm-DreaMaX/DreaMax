---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/navigation/Header.astro";
import Footer from "../components/ui/PortfolioFooter.astro";


interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
}

const { title, description, showFooter = true } = Astro.props;
---

<BaseLayout {title} {description}>
  <Header />
  <div class:list={['dm-page', {'dm-tool-page': Astro.url.pathname.startsWith('/tools/') && Astro.url.pathname.split('/').filter(Boolean).length > 1}]}>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </div>
  {showFooter && <Footer />}
</BaseLayout>
