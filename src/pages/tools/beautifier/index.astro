---
import PageLayout from "../../../layouts/PageLayout.astro";
---

<PageLayout title="DreaMax Beautifier — Photo Enhancer">
  <section class="min-h-screen px-6 pt-32 pb-24">
    <div class="mx-auto" style="max-width:900px;">
      <a href="/tools" class="font-mono text-sm link-underline" style="color:rgba(255,255,255,0.4);">&larr; Back to Tools</a>

      <h1 class="section-heading" style="margin:24px 0 8px;">
        <span class="accent-bar" style="background:#e31b6d;"></span>DreaMax Beautifier
      </h1>
      <p class="font-mono text-sm" style="color:rgba(255,255,255,0.4);">上传照片，一键美颜。所有处理在本地完成，不上传服务器。</p>

      <!-- Upload area -->
      <div id="upload-area" class="upload-area" style="margin-top:32px;">
        <div id="drop-zone" class="drop-zone" role="button" tabindex="0" aria-label="选择要编辑的图片">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:rgba(255,255,255,0.3);">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <p style="margin:12px 0 0;font-family:'JetBrains Mono',monospace;font-size:13px;color:rgba(255,255,255,0.35);">点击或拖拽图片到这里</p>
          <p style="margin:4px 0 0;font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.2);">JPG / PNG / WebP</p>
        </div>
        <input type="file" id="file-input" accept="image/*" style="display:none;" />
      </div>

      <!-- Editor area (hidden until image loaded) -->
      <div id="editor-area" style="display:none;margin-top:32px;">
        <div class="flex flex-col md:flex-row gap-6">
          <!-- Before/After -->
          <div class="flex-1">
            <div class="image-wrap">
              <canvas id="canvas-main" style="width:100%;border-radius:12px;border:1px solid rgba(255,255,255,0.06);"></canvas>
            </div>
            <div class="flex gap-3 mt-3">
              <button id="btn-download" class="btn btn-pink" style="padding:8px 20px;font-size:12px;">下载</button>
              <button id="btn-auto" class="btn btn-ghost" style="padding:8px 20px;font-size:12px;">一键美颜</button>
              <button id="btn-reset" class="btn btn-ghost" style="padding:8px 20px;font-size:12px;">重置</button>
            </div>
          </div>

          <!-- Controls -->
          <div class="controls-panel" style="flex:0 0 240px;">
            <div class="control-group">
              <label class="ctrl-label" for="sl-brightness">亮度</label>
              <input type="range" id="sl-brightness" min="-50" max="50" value="0" class="ctrl-slider" />
            </div>
            <div class="control-group">
              <label class="ctrl-label" for="sl-contrast">对比度</label>
              <input type="range" id="sl-contrast" min="-50" max="50" value="0" class="ctrl-slider" />
            </div>
            <div class="control-group">
              <label class="ctrl-label" for="sl-saturate">饱和度</label>
              <input type="range" id="sl-saturate" min="-50" max="50" value="0" class="ctrl-slider" />
            </div>
            <div class="control-group">
              <label class="ctrl-label" for="sl-warmth">暖色</label>
              <input type="range" id="sl-warmth" min="-50" max="50" value="0" class="ctrl-slider" />
            </div>
            <div class="control-group">
              <label class="ctrl-label" for="sl-sharpen">锐度</label>
              <input type="range" id="sl-sharpen" min="0" max="100" value="0" class="ctrl-slider" />
            </div>
            <div class="control-group">
              <label class="ctrl-label" for="sl-whiten">美白</label>
              <input type="range" id="sl-whiten" min="0" max="100" value="0" class="ctrl-slider" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
(function(){
  var dropZone = document.getElementById('drop-zone');
  var fileInput = document.getElementById('file-input');
  var uploadArea = document.getElementById('upload-area');
  var editorArea = document.getElementById('editor-area');
  var canvas = document.getElementById('canvas-main');
  var ctx = canvas.getContext('2d');

  var originalImage = null;
  var processedImage = null;

  dropZone.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();fileInput.click();}});
  /* Sliders */
  var sliders = {
    brightness: document.getElementById('sl-brightness'),
    contrast: document.getElementById('sl-contrast'),
    saturate: document.getElementById('sl-saturate'),
    warmth: document.getElementById('sl-warmth'),
    sharpen: document.getElementById('sl-sharpen'),
    whiten: document.getElementById('sl-whiten'),
  };

  /* ── Upload ── */
  function handleFile(file){
    if(!file || !file.type.startsWith('image/')) return;
    var reader = new FileReader();
    reader.onload = function(e){
      var img = new Image();
      img.onload = function(){
        originalImage = img;
        uploadArea.style.display = 'none';
        editorArea.style.display = 'block';
        resizeCanvas(img);
        render();
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  dropZone.addEventListener('click', function(){ fileInput.click(); });
  fileInput.addEventListener('change', function(e){
    if(e.target.files.length > 0) handleFile(e.target.files[0]);
  });

  /* Drag & drop */
  dropZone.addEventListener('dragover', function(e){ e.preventDefault(); dropZone.style.borderColor = 'rgba(102,217,237,0.5)'; });
  dropZone.addEventListener('dragleave', function(){ dropZone.style.borderColor = 'rgba(255,255,255,0.08)'; });
  dropZone.addEventListener('drop', function(e){
    e.preventDefault();
    dropZone.style.borderColor = 'rgba(255,255,255,0.08)';
    if(e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]);
  });

  /* ── Canvas ── */
  function resizeCanvas(img){
    var maxW = 600, maxH = 600;
    var w = img.width, h = img.height;
    if(w > maxW || h > maxH){
      var ratio = Math.min(maxW/w, maxH/h);
      w = Math.floor(w * ratio);
      h = Math.floor(h * ratio);
    }
    canvas.width = w;
    canvas.height = h;
  }

  function render(){
    if(!originalImage) return;
    var w = canvas.width, h = canvas.height;
    ctx.drawImage(originalImage, 0, 0, w, h);

    var imageData = ctx.getImageData(0, 0, w, h);
    var data = imageData.data;
    var b = parseInt(sliders.brightness.value);
    var c = parseInt(sliders.contrast.value);
    var s = parseInt(sliders.saturate.value);
    var wt = parseInt(sliders.warmth.value);
    var sh = parseInt(sliders.sharpen.value) / 100;
    var wh = parseInt(sliders.whiten.value) / 100;

    /* Contrast factor */
    var cf = (100 + c) / 100;

    for(var i=0;i<data.length;i+=4){
      var r = data[i], g = data[i+1], bl = data[i+2];

      /* Brightness */
      r += b; g += b; bl += b;

      /* Contrast */
      r = (r - 128) * cf + 128;
      g = (g - 128) * cf + 128;
      bl = (bl - 128) * cf + 128;

      /* Saturation */
      var gray = 0.299 * r + 0.587 * g + 0.114 * bl;
      var sf = (100 + s) / 100;
      r = gray + (r - gray) * sf;
      g = gray + (g - gray) * sf;
      bl = gray + (bl - gray) * sf;

      /* Warmth */
      r += wt * 0.8;
      g += wt * 0.2;
      bl -= wt * 0.5;

      /* Whiten (skin-like brightening) */
      if(wh > 0){
        var avg = (r + g + bl) / 3;
        if(avg > 80){
          r += (255 - r) * wh * 0.3;
          g += (255 - g) * wh * 0.3;
          bl += (255 - bl) * wh * 0.35;
        }
      }

      data[i] = clamp(r);
      data[i+1] = clamp(g);
      data[i+2] = clamp(bl);
    }

    /* Simple sharpen (unsharp mask approximation) */
    if(sh > 0.01){
      var blurred = new Uint8ClampedArray(data);
      /* Simple 3x3 blur */
      for(var y=1;y<h-1;y++) for(var x=1;x<w-1;x++){
        var idx = (y*w + x) * 4;
        var sumR = 0, sumG = 0, sumB = 0;
        for(var ky=-1;ky<=1;ky++) for(var kx=-1;kx<=1;kx++){
          var nIdx = ((y+ky)*w + (x+kx)) * 4;
          sumR += data[nIdx]; sumG += data[nIdx+1]; sumB += data[nIdx+2];
        }
        blurred[idx] = sumR/9; blurred[idx+1] = sumG/9; blurred[idx+2] = sumB/9;
      }
      /* Blend toward original */
      for(var j=0;j<data.length;j+=4){
        data[j] = clamp(data[j] + (data[j] - blurred[j]) * sh);
        data[j+1] = clamp(data[j+1] + (data[j+1] - blurred[j+1]) * sh);
        data[j+2] = clamp(data[j+2] + (data[j+2] - blurred[j+2]) * sh);
      }
    }

    ctx.putImageData(imageData, 0, 0);
    processedImage = canvas.toDataURL();
  }

  function clamp(v){ return Math.max(0, Math.min(255, Math.round(v))); }

  /* ── Controls ── */
  Object.values(sliders).forEach(function(sl){
    sl.addEventListener('input', render);
  });

  /* Auto beautify */
  document.getElementById('btn-auto').addEventListener('click', function(){
    sliders.brightness.value = 8;
    sliders.contrast.value = 12;
    sliders.saturate.value = 15;
    sliders.warmth.value = 10;
    sliders.sharpen.value = 30;
    sliders.whiten.value = 40;
    render();
  });

  /* Reset */
  document.getElementById('btn-reset').addEventListener('click', function(){
    Object.values(sliders).forEach(function(sl){ sl.value = 0; });
    render();
  });

  /* Download */
  document.getElementById('btn-download').addEventListener('click', function(){
    if(!processedImage) return;
    var a = document.createElement('a');
    a.href = processedImage;
    a.download = 'dreamax-beautified.png';
    a.click();
  });
})();
</script>

<style>
.drop-zone {
  border: 2px dashed rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 60px 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
  background: rgba(255,255,255,0.02);
}
.drop-zone:hover {
  border-color: rgba(102,217,237,0.3);
  background: rgba(102,217,237,0.03);
}

.controls-panel {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.control-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.ctrl-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 2px;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
}
.ctrl-slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 4px;
  border-radius: 2px;
  background: rgba(255,255,255,0.08);
  outline: none;
  transition: background 0.2s;
}
.ctrl-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #66d9ed;
  cursor: pointer;
  box-shadow: 0 0 8px rgba(102,217,237,0.3);
}
.ctrl-slider::-moz-range-thumb {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #66d9ed;
  cursor: pointer;
  border: none;
}
</style>
