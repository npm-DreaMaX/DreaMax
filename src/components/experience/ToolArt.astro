---
interface Props { kind: string }
const {kind}=Astro.props;
---
<svg viewBox="0 0 400 280" class={`dm-tool-illustration illustration-${kind}`} fill="none" aria-hidden="true">
 {kind==='mixture' && <g transform="translate(88 35)"><path d="M0 209h224" stroke="#586448"/>{[95,145,190,122,165].map((h,i)=><g transform={`translate(${i*46} 0)`}><rect x="0" y={209-h} width="28" height={h*.4} fill="#f0eedb"/><rect x="0" y={209-h*.6} width="28" height={h*.35} fill="#a2b388"/><rect x="0" y={209-h*.25} width="28" height={h*.25} fill="#4e6749"/></g>)}<path d="m8 85 47-33 44 4 46-30 46-9" stroke="#46563a" stroke-width="2" stroke-dasharray="4 5"/></g>}
 {kind==='rollout' && <g stroke="#7e6c59" stroke-width="2"><path d="M75 140h62m0 0 64-66h69m-133 66h133m-133 0 64 66h69"/><g fill="#ece0ce"><circle cx="75" cy="140" r="22"/><circle cx="202" cy="74" r="17"/><circle cx="202" cy="140" r="17"/><circle cx="202" cy="206" r="17"/></g><g fill="#667151" stroke="none"><rect x="270" y="54" width="48" height="40" rx="3"/><rect x="270" y="120" width="48" height="40" rx="3"/><rect x="270" y="186" width="48" height="40" rx="3"/></g><path d="m283 73 7 7 14-15m-21 74 7 7 14-15m-21 74 7 7 14-15" stroke="#eef0dc"/></g>}
 {kind==='systems' && <g transform="translate(200 140) rotate(-12) translate(-200 -140)" stroke="#597582" stroke-width="2"><rect x="95" y="46" width="210" height="188" rx="10" fill="#ccd8da"/><rect x="133" y="78" width="134" height="123" rx="3" fill="#789096"/>{[0,1,2,3].map(i=><><path d={`M${151+i*30} 46v32M${151+i*30} 201v33M95 ${96+i*29}h38M267 ${96+i*29}h38`}/>{[0,1,2,3].map(j=><rect x={145+j*29} y={91+i*27} width="19" height="17" fill={(i+j)%3===0?'#e5ecdf':'#b5c8c6'} stroke="none"/>)}</>)}</g>}
 {kind==='gomoku' && <g transform="translate(200 140) rotate(-18) translate(-200 -140)"><rect x="86" y="25" width="228" height="228" rx="5" fill="#e0c0a3"/><g stroke="#99806a" stroke-width=".8">{Array.from({length:9},(_,i)=><><path d={`M${104+i*24} 44v192`}/><path d={`M104 ${44+i*24}h192`}/></>)}</g><g fill="#242721">{[[176,116],[200,140],[224,164],[152,92]].map(([x,y])=><><ellipse cx={x+2} cy={y+4} rx="11" ry="10" fill="#533e2d" opacity=".24"/><circle cx={x} cy={y} r="10.5"/></>)}</g><g fill="#f6f1e4">{[[200,116],[176,140],[248,164]].map(([x,y])=><><ellipse cx={x+2} cy={y+4} rx="11" ry="10" fill="#533e2d" opacity=".24"/><circle cx={x} cy={y} r="10.5"/></>)}</g></g>}
 {kind==='photo' && <g transform="rotate(9 200 140)"><rect x="88" y="38" width="220" height="214" rx="3" fill="#fcf9f0"/><rect x="100" y="50" width="196" height="161" fill="#9caa98"/><circle cx="242" cy="88" r="21" fill="#e6dcc3"/><path d="m100 190 61-89 51 75 34-46 50 69v12H100Z" fill="#576e5d"/><path d="m100 211 83-83 62 83Z" fill="#344f43"/><path d="M140 234h98" stroke="#afa899" stroke-width="2"/><g transform="rotate(-9 200 140)"><rect x="252" y="118" width="45" height="101" rx="22" fill="#e9edda"/><path d="M274 138v59" stroke="#727b63" stroke-width="2"/><circle cx="274" cy="157" r="7" fill="#353f30"/></g></g>}
 {kind==='mail' && <g transform="translate(200 140) rotate(-13) translate(-200 -140)"><rect x="83" y="80" width="235" height="150" rx="8" fill="#cdd4dc"/><path d="m83 86 117 88L318 86" fill="#edf0ee"/><path d="m83 230 91-75m144 75-91-75" stroke="#b3bdc8" stroke-width="2"/><rect x="115" y="32" width="175" height="99" rx="3" fill="#faf8ee"/><path d="M138 58h55m-55 19h124m-124 17h105" stroke="#a8b4ba" stroke-width="3"/><path d="m83 88 117 88L318 88v130a12 12 0 0 1-12 12H95a12 12 0 0 1-12-12Z" fill="#d7dfe2"/><path d="m83 230 91-75m144 75-91-75" stroke="#b3bdc8" stroke-width="2"/><circle cx="305" cy="79" r="22" fill="#3e5d70"/><path d="m295 78 7 7 12-14" stroke="#faf8ee" stroke-width="3"/></g>}
 {kind==='focus' && <g><circle cx="200" cy="140" r="91" stroke="#d8dec7" stroke-width="30"/><path d="M200 49a91 91 0 1 1-91 91" stroke="#687951" stroke-width="30" stroke-linecap="round"/><path d="m166 140 23 23 49-52" stroke="#e6ebd9" stroke-width="7" stroke-linecap="round"/></g>}
 {kind==='files' && <g transform="rotate(-10 200 140)"><rect x="118" y="47" width="160" height="198" rx="5" fill="#cab198"/><rect x="98" y="37" width="160" height="198" rx="5" fill="#eee4d7"/><path d="M129 84h100m-100 24h70m-70 24h100" stroke="#b5a48f" stroke-width="4"/><circle cx="251" cy="195" r="44" fill="#6d7352"/><path d="M251 217v-44m-17 17 17-17 17 17" stroke="#f6f0e2" stroke-width="4"/></g>}
 {kind==='text' && <g><rect x="83" y="54" width="234" height="169" rx="6" fill="#e0e7e7"/><path d="M110 89h143m-143 28h175m-175 28h113m-113 28h163" stroke="#9aaeb5" stroke-width="5"/><path d="M224 164h61" stroke="#476675" stroke-width="12"/><path d="M288 152v25" stroke="#476675" stroke-width="3"/></g>}
 {kind==='personality' && <g><circle cx="162" cy="141" r="75" fill="#e1c5ae"/><circle cx="232" cy="141" r="75" fill="#a28e76" fill-opacity=".8"/><circle cx="141" cy="131" r="5" fill="#504435"/><circle cx="180" cy="131" r="5" fill="#504435"/><path d="M143 155q20 23 38 0" stroke="#504435" stroke-width="3"/><circle cx="217" cy="128" r="5" fill="#f0e9de"/><circle cx="254" cy="128" r="5" fill="#f0e9de"/><path d="M217 156h37" stroke="#f0e9de" stroke-width="3"/></g>}
</svg>
