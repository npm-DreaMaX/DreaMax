---
const values = [6,2,8,4,1,7,3,9,5];
---
<div class="sorting-scene" data-sorting-scene>
  <div class="sort-heading"><span>BUBBLE SORT</span><span data-sort-status aria-live="polite">比较相邻元素</span></div>
  <div class="sort-perspective" aria-label="排序序列"><div class="sort-bars">{values.map((value,i)=><div class="sort-bar" data-sort-value={value} style={`--bar-index:${i};--bar-value:${value}`}><span>{value}</span></div>)}</div></div>
  <p class="sort-readout" data-sort-readout>6 · 2 · 8 · 4 · 1 · 7 · 3 · 9 · 5</p>
  <div class="sort-controls"><button data-sort-play disabled>自动播放 ↗</button><button data-sort-step disabled>下一步</button><button data-sort-reset disabled>重排 ↺</button></div>
</div>
<script>
  import { initSortingScenes } from '../../scripts/sorting-scenes';
  initSortingScenes();
</script>
<style>
.sorting-scene { min-width:0; padding:20px 0; color:#171717; }
.sort-heading { display:flex;justify-content:space-between;gap:12px;font:500 10px/1.5 var(--dm-font);letter-spacing:.04em; }
.sort-heading > span:last-child { font-size:11px;letter-spacing:0; }
.sort-perspective { height:300px;perspective:900px;display:grid;place-items:center;overflow:hidden; }
.sort-bars { position:relative;width:290px;height:170px;transform:rotateX(12deg) rotateY(-18deg);transform-style:preserve-3d; }
.sort-bars::before { content:'';position:absolute;left:-25px;right:-25px;bottom:-1px;height:1px;background:#17171725;box-shadow:0 7px 16px #17171722; }
.sort-bar { position:absolute;bottom:0;left:0;width:19px;height:calc(var(--bar-value)*17px);transform:translateX(calc(var(--bar-index)*32px));background:linear-gradient(90deg,#1a1a1a,#444 75%,#777);border-radius:2px 1px 0 0;box-shadow:8px 10px 12px #17171712;transition:transform .42s cubic-bezier(.16,1,.3,1),background .25s;transform-style:preserve-3d; }
.sort-bar::after { content:'';position:absolute;right:-6px;width:6px;height:100%;background:linear-gradient(90deg,#1b1b1b,#353535);transform-origin:left;transform:skewY(-35deg);top:-2px; }
.sort-bar::before { content:'';position:absolute;top:-4px;left:3px;width:19px;height:4px;background:#a5a5a5;transform:skewX(-55deg);border-top:1px solid #e1e1e1; }
.sort-bar[data-active='true'] { background:linear-gradient(90deg,#e9500d,#ff712e 60%,#ff9e71); }
.sort-bar[data-active='true']::after { background:#c9440c; }.sort-bar[data-active='true']::before { background:#ffc7a7;border-color:#ffe8dc; }
.sort-bar > span { position:absolute;bottom:-28px;width:100%;font:500 12px/1 monospace;text-align:center; }
.sort-readout { text-align:center;font:400 12px/1.6 monospace;letter-spacing:.1em;margin-bottom:22px; }
.sort-controls { border-block:1px solid #17171730;display:flex;justify-content:space-between;gap:8px; }
.sort-controls button { min-height:48px;padding:0 10px;font:500 11px/1.5 var(--dm-font);cursor:pointer;transition:color .2s;background:none;border:0; }
.sort-controls button:hover { color:#b7390a; }.sort-controls button:disabled { opacity:.35;cursor:default; }.sort-controls button:focus-visible { outline:2px solid currentColor;outline-offset:2px; }
@media(max-width:760px) { .sort-perspective { height:240px; }.sort-bars { scale:.88; } }
@media(prefers-reduced-motion:reduce) { .sort-bar { transition:none; } }
</style>
