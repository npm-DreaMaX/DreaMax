---
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="tools" class="px-6 py-24">
  <div class="mx-auto" style="max-width:1100px;">
    <p class="portfolio-section-kicker">04 / LITTLE THINGS I BUILT</p>
    <SectionHeading label="Fun Tools" accent="purple" />

    <div class="grid gap-6 md:grid-cols-3" style="margin-top:48px;">
      <!-- Gomoku -->
      <a href="/tools/gomoku" class="block no-underline">
        <Card clickable>
          <div class="flex h-full flex-col gap-4 p-6" data-click-card>
            <div class="flex items-center gap-2">
              <span style="font-size:24px;">⚫</span>
              <span class="font-mono text-xs tracking-widest" style="color:#c586c0;">GAME</span>
            </div>
            <h3 class="font-sans text-lg font-semibold text-white">五子棋 Gomoku</h3>
            <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.5); font-weight:300;">
              经典 15×15 五子棋，AI 对手三档难度，落子音效 + 背景音乐。
            </p>
            <div class="mt-auto flex flex-wrap gap-2">
              <span class="inline-block rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">AI</span>
              <span class="inline-block rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">音效</span>
              <span class="inline-block rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">休闲/标准/挑战</span>
            </div>
          </div>
        </Card>
      </a>

      <!-- Beautifier -->
      <a href="/tools/beautifier" class="block no-underline">
        <Card clickable>
          <div class="flex h-full flex-col gap-4 p-6" data-click-card>
            <div class="flex items-center gap-2">
              <span style="font-size:24px;">✨</span>
              <span class="font-mono text-xs tracking-widest" style="color:#66d9ed;">PHOTO</span>
            </div>
            <h3 class="font-sans text-lg font-semibold text-white">DreaMax Beautifier</h3>
            <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.5); font-weight:300;">
              一键美颜。亮度/对比度/饱和度/美白/锐化，实时预览，纯前端处理。
            </p>
            <div class="mt-auto flex flex-wrap gap-2">
              <span class="inline-block rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">纯前端</span>
              <span class="inline-block rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">实时预览</span>
            </div>
          </div>
        </Card>
      </a>

      <!-- TempMail -->
      <a href="/tools/tempmail" class="block no-underline">
        <Card clickable>
          <div class="flex h-full flex-col gap-4 p-6" data-click-card>
            <div class="flex items-center gap-2">
              <span style="font-size:24px;">📧</span>
              <span class="font-mono text-xs tracking-widest" style="color:#66d9ed;">UTILITY</span>
            </div>
            <h3 class="font-sans text-lg font-semibold text-white">TempMail</h3>
            <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.5); font-weight:300;">
              临时邮箱生成器。一键生成，自动收件，零注册，保护隐私。
            </p>
            <div class="mt-auto flex flex-wrap gap-2">
              <span class="inline-block rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">免费</span>
              <span class="inline-block rounded-full border border-white/8 px-3 py-0.5 font-mono text-xs text-white/35">自动收件</span>
            </div>
          </div>
        </Card>
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-click-card]").forEach((el) => {
    const card = el.closest("[data-clickable]");
    if (!card) return;
    const cls = "card-clicked";
    card.addEventListener("mousedown", () => card.classList.add(cls));
    card.addEventListener("mouseup", () => setTimeout(() => card.classList.remove(cls), 150));
    card.addEventListener("mouseleave", () => card.classList.remove(cls));
    card.addEventListener("touchstart", () => card.classList.add(cls), { passive: true });
    card.addEventListener("touchend", () => setTimeout(() => card.classList.remove(cls), 150), { passive: true });
  });
</script>
