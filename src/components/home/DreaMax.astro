---
import { profile } from '../../data/profile';
import DreaMaxLogo from '../ui/DreaMaxLogo.astro';
import GradientBackground from '../ui/GradientBackground.astro';
import '@fontsource/cormorant-garamond/500-italic.css';
---
<section id="dreamax" class="expedition-hero" aria-label="DreaMax 个人主页">
  <GradientBackground />
  <div class="hero-content">
    <div class="portfolio-identity">
      <DreaMaxLogo />
    </div>
    <p class="portfolio-focus">{profile.title}</p>
    <div class="portfolio-hero-actions">
      <a href="/llm-training/" class="hero-primary">进入 LLM Training <span aria-hidden="true">↗</span></a>
      <a href="#projects" class="hero-secondary">查看项目 <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <div class="hero-baseline">
    <div class="hero-socials"><a href={profile.social.github} target="_blank" rel="noreferrer">GITHUB ↗</a><a href={profile.social.csdn} target="_blank" rel="noreferrer">CSDN ↗</a></div>
    <blockquote class="portfolio-quote" lang="en"><p><span>With resolve I depart;</span> <span>in greater glory I shall return.</span></p></blockquote>
  </div>
</section>
<script>
  import { initExpeditionHero } from '../../scripts/expedition';
  initExpeditionHero();
</script>
