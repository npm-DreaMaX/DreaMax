---
import TagBadge from "../ui/TagBadge.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { featuredProjects } from "../../data/featured";
---
<section id="projects" class="px-6 py-24">
  <div class="mx-auto" style="max-width:1100px;">
    <div class="portfolio-project-heading"><SectionHeading label="Projects" accent="cyan" /><a href="https://github.com/npm-DreaMaX" target="_blank" rel="noreferrer">ALL ON GITHUB ↗</a></div>
    <div class="portfolio-project-grid">
      {featuredProjects.map((item, index) => <a class="portfolio-project" href={item.link} target="_blank" rel="noreferrer">
        <div class="portfolio-project-top"><span>0{index+1} / OPEN SOURCE</span><span aria-hidden="true">↗</span></div>
        <div class={`portfolio-project-glyph glyph-${index}`} aria-hidden="true"><i></i><i></i><i></i></div>
        <h3>{item.title}</h3><p>{item.description}</p>
        <div class="portfolio-project-tags">{item.tags.map(tag => <TagBadge label={tag} variant="subtle" />)}</div>
      </a>)}
    </div>
  </div>
</section>
