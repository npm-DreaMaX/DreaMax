---
import TrainingField from './TrainingField.astro';
import { algorithmArticles } from '../../data/algorithms';
const phases = [
  { name: 'Pre-training', zh: '预训练', title: '让数据，变成能力。', text: '数据配方、MoE、数值精度与训练预算。从技术报告进入真正的训练现场。', href: '/fieldwork/paths/pretraining', label: 'DATA → PARAMETERS', color: '#ff8b54' },
  { name: 'Mid-training', zh: '中训练', title: '把能力，推向更远。', text: '继续预训练、长上下文与能力塑形。看懂训练阶段之间，数据与目标如何切换。', href: '/fieldwork/paths/midtraining', label: 'CONTEXT → CAPABILITY', color: '#efc882' },
  { name: 'Post-training', zh: '后训练', title: '让模型，学会选择。', text: '从 SFT、偏好优化到可验证奖励，理解模型行为背后的训练策略。', href: '/fieldwork/paths/posttraining', label: 'FEEDBACK → BEHAVIOR', color: '#d6bea4' },
  { name: 'Agentic RL', zh: 'Agentic RL', title: '从回答，走向行动。', text: '把长轨迹、环境、奖励与异步 rollout 放到同一个系统里理解。', href: '/fieldwork/paths/agentic', label: 'EXPERIENCE → POLICY', color: '#f8a36f' },
];
const notes = ['161870362','160561647','161896756'].map(id => algorithmArticles.find(a => a.id === id)!);
---
<section id="explore" class="home-manifesto stage-shell" aria-labelledby="manifesto-heading">
  <div class="stage-meta"><span>THE NEXT ADVENTURE</span><span>01 — 05 / KEEP EXPLORING</span></div>
  <div class="manifesto-layout">
    <h2 id="manifesto-heading" data-reveal>好奇心，<br/>值得<span>付诸行动。</span></h2>
    <div class="manifesto-note" data-reveal><span class="manifesto-asterisk orbix-x" aria-hidden="true">x</span><p>我是 DreaMax。<br/>专注大模型预训练与 Agentic RL，<br/>在论文、代码和实验之间不断往返。</p><a href="/join/" class="stage-text-link">更多关于我 <span aria-hidden="true">↗</span></a></div>
  </div>
  <nav class="stage-jumpbar" aria-label="首页探索路线"><a href="#training">01 <span>学习</span> ↘</a><a href="#research">02 <span>研究</span> ↘</a><a href="#algorithm">03 <span>算法</span> ↘</a><a href="#projects">04 <span>项目</span> ↘</a><a href="#tools">05 <span>有趣的东西</span> ↘</a></nav>
</section>

<section id="training" class="home-training stage-shell" aria-labelledby="training-heading" data-home-stage>
  <div class="stage-meta"><span>01 / THE LEARNING SPACE</span><span>PAPERS. CODE. EXPERIMENTS.</span></div>
  <div class="training-stage-layout">
    <div class="stage-story" data-reveal><h2 id="training-heading" class="stage-display">LLM<br/><span>TRAINING</span><sup>↗</sup></h2><p class="stage-intro">走进模型背后的世界。</p><p class="stage-description">沿着顶尖模型的技术报告，<br/>拆解从数据、训练到自主行动的完整路径。</p><a href="/llm-training/" class="stage-button home-training-entry">探索 LLM Training <span aria-hidden="true">↗</span></a></div>
    <TrainingField />
  </div>
  <div class="training-console" data-home-training>
    <div class="training-phase-tabs" role="tablist" aria-label="训练阶段">{phases.map((phase, i) => <button id={`phase-tab-${i}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`phase-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-phase-tab={i} data-field-color={phase.color}><small>0{i+1}</small><span>{phase.name}</span><span class="phase-tab-arrow" aria-hidden="true">↗</span></button>)}</div>
    {phases.map((phase, i) => <div id={`phase-panel-${i}`} role="tabpanel" aria-labelledby={`phase-tab-${i}`} tabindex="0" class="training-phase-panel" hidden={i !== 0}><div><small>{phase.label}</small><h3>{phase.title}</h3></div><p>{phase.text}</p><a href={phase.href} aria-label={`阅读${phase.zh}路线`}>进入{phase.zh} <span aria-hidden="true">↗</span></a></div>)}
    <noscript><p>直接选择学习路线：{phases.map(phase => <a href={phase.href}>{phase.zh} ↗ </a>)}</p></noscript>
  </div>
</section>

<section id="research" class="home-agents stage-shell" aria-labelledby="agents-heading" data-home-stage>
  <div class="stage-meta"><span>02 / AGENTIC SCHOLAR</span><span>INTELLIGENCE, IN ACTION.</span></div>
  <div class="agent-stage-layout">
    <div class="stage-story" data-reveal><h2 id="agents-heading" class="stage-display">THINK.<br/>ACT.<br/><span>LEARN.</span></h2><p class="stage-intro">理解世界，然后改变一点。</p><p class="stage-description">研究 Agent 如何使用工具、感知环境，<br/>在一次次行动与反馈中完成复杂任务。</p><a href="/agentic-scholar/" class="stage-button">进入 Agentic Scholar <span aria-hidden="true">↗</span></a></div>
    <div class="agent-trajectory" data-agent-demo aria-label="Agent 交互轨迹示意">
      <div class="trajectory-label"><span>AN AGENT'S JOURNEY</span><span>交互示意</span></div>
      <svg class="trajectory-orbit" viewBox="0 0 500 500" fill="none" aria-hidden="true"><circle cx="250" cy="250" r="218"/><circle cx="250" cy="250" r="170" stroke-dasharray="2 9"/><ellipse cx="250" cy="250" rx="217" ry="86" transform="rotate(-36 250 250)"/><path d="M32 250h436M250 32v436"/>{[[250,32],[468,250],[250,468],[32,250]].map(([x,y],i)=><g class:list={['trajectory-node',{'is-active':i===0}]} data-trajectory-node={i}><circle cx={x} cy={y} r="10"/></g>)}</svg>
      <div class="trajectory-core" aria-live="polite"><span class="trajectory-step" data-agent-number>01</span><strong data-agent-title>接收任务</strong><p data-agent-detail>修复一个失败的单元测试。</p></div>
      <div class="trajectory-controls" role="group" aria-label="查看轨迹步骤">{['任务','动作','观察','验证'].map((label,i)=><button data-agent-step={i} aria-pressed={i===0?'true':'false'}><span>0{i+1}</span>{label}</button>)}</div>
      <button class="trajectory-next" data-agent-next>回放下一步 <span aria-hidden="true">→</span></button>
    </div>
  </div>
  <div class="agent-keywords" aria-hidden="true"><span>POLICY</span><i>↗</i><span>ENVIRONMENT</span><i>↗</i><span>FEEDBACK</span><i>↗</i><span>POLICY</span></div>
</section>

<section id="algorithm" class="home-algorithms stage-shell" aria-labelledby="algorithm-stage-heading" data-home-stage>
  <div class="stage-meta"><span>03 / THINK IT THROUGH</span><span>PERSONAL NOTES · CSDN</span></div>
  <h2 id="algorithm-stage-heading" class="algorithm-stage-title" data-reveal>ALGORITHM<span aria-hidden="true">↗</span></h2>
  <div class="algorithm-stage-layout">
    <div class="algorithm-count-art" aria-label={`${algorithmArticles.length} 篇原创算法笔记`}><span class="algorithm-orbit" aria-hidden="true"></span><strong>{algorithmArticles.length.toString().padStart(2,'0')}</strong><span class="algorithm-count-label">NOTES & COUNTING</span><span class="algorithm-count-brace" aria-hidden="true">{'{ }'}</span></div>
    <div class="algorithm-stage-notes"><p class="stage-intro">把每一步想清楚。<br/>把想明白的，写下来。</p><div class="algorithm-preview-list">{notes.map((note,i)=><a href={note.url} target="_blank" rel="noreferrer"><small>0{i+1} / {note.tags[0]}</small><span>{note.title}</span><b aria-hidden="true">↗</b></a>)}</div><a class="stage-button" href="/algorithms/">阅读全部 {algorithmArticles.length} 篇笔记 <span aria-hidden="true">↗</span></a></div>
  </div>
</section>

<script>
  import { initHomeStages } from '../../scripts/home-stages';
  initHomeStages();
</script>
