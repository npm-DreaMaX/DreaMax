---
import SpatialScene from '../experience/SpatialScene.astro';
import SortingScene from '../experience/SortingScene.astro';
import { algorithmArticles } from '../../data/algorithms';
const phases = [
  { name: 'Pre-training', zh: '预训练', title: '数据、架构与训练预算', text: '数据配方、MoE、数值精度与训练预算。对照技术报告与源码阅读。', href: '/fieldwork/paths/pretraining', label: 'DATA → PARAMETERS', color: '#ff712e' },
  { name: 'Mid-training', zh: '中训练', title: '长上下文与能力塑形', text: '继续预训练、长上下文与能力塑形。分析训练阶段的数据分布与目标切换。', href: '/fieldwork/paths/midtraining', label: 'CONTEXT → CAPABILITY', color: '#ff864d' },
  { name: 'Post-training', zh: '后训练', title: 'SFT、偏好优化与推理 RL', text: '比较监督微调、偏好优化与可验证奖励的目标和数据形式。', href: '/fieldwork/paths/posttraining', label: 'FEEDBACK → BEHAVIOR', color: '#f4f3f0' },
  { name: 'Agentic RL', zh: 'Agentic RL', title: '环境、轨迹与策略更新', text: '长轨迹交互、奖励设计与异步 rollout 的算法和系统实现。', href: '/fieldwork/paths/agentic', label: 'EXPERIENCE → POLICY', color: '#ffa276' },
];
const notes = ['161870362','160561647','161896756'].map(id => algorithmArticles.find(a => a.id === id)!);
---
<section id="explore" class="home-manifesto stage-shell" aria-labelledby="manifesto-heading">
  <div class="stage-meta"><span>CONTENTS</span><span>01 — 05</span></div>
  <div class="manifesto-layout">
    <h2 id="manifesto-heading" data-reveal>学习笔记<br/><span>与开源项目</span></h2>
    <div class="manifesto-note" data-reveal><span class="manifesto-asterisk orbix-x" aria-hidden="true">x</span><p>主要关注 LLM training 与 RSI。<br/>这里整理了论文笔记、开源项目和工具。</p><a href="/join/" class="stage-text-link">更多关于我 <span aria-hidden="true">↗</span></a></div>
  </div>
  <nav class="stage-jumpbar" aria-label="首页探索路线"><a href="#training">01 <span>学习</span> ↘</a><a href="#research">02 <span>研究</span> ↘</a><a href="#algorithm">03 <span>算法</span> ↘</a><a href="#projects">04 <span>项目</span> ↘</a><a href="#tools">05 <span>工具</span> ↘</a></nav>
</section>

<section id="training" class="home-training stage-shell" aria-labelledby="training-heading" data-home-stage>
  <div class="stage-meta"><span>01 / LLM TRAINING</span><span>PAPERS. CODE. EXPERIMENTS.</span></div>
  <div class="training-stage-layout">
    <div class="stage-story" data-reveal><h2 id="training-heading" class="stage-display">LLM<br/><span>TRAINING</span><sup>↗</sup></h2><p class="stage-intro">技术报告与训练实验</p><p class="stage-description">预训练、中训练、后训练与 Agentic RL。<br/>包含论文精读、源码导读和交互实验。</p><a href="/llm-training/" class="stage-button home-training-entry">进入 LLM Training <span aria-hidden="true">↗</span></a></div>
    <SpatialScene variant="training" label="训练参数形态" />
  </div>
  <div class="training-console" data-home-training>
    <div class="training-phase-tabs" role="tablist" aria-label="训练阶段">{phases.map((phase, i) => <button id={`phase-tab-${i}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`phase-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-phase-tab={i} data-field-color={phase.color}><small>0{i+1}</small><span>{phase.name}</span><span class="phase-tab-arrow" aria-hidden="true">↗</span></button>)}</div>
    {phases.map((phase, i) => <div id={`phase-panel-${i}`} role="tabpanel" aria-labelledby={`phase-tab-${i}`} tabindex="0" class="training-phase-panel" hidden={i !== 0}><div><small>{phase.label}</small><h3>{phase.title}</h3></div><p>{phase.text}</p><a href={phase.href} aria-label={`阅读${phase.zh}路线`}>进入{phase.zh} <span aria-hidden="true">↗</span></a></div>)}
    <noscript><p>直接选择学习路线：{phases.map(phase => <a href={phase.href}>{phase.zh} ↗ </a>)}</p></noscript>
  </div>
</section>

<section id="research" class="home-agents stage-shell" aria-labelledby="agents-heading" data-home-stage>
  <div class="stage-meta"><span>02 / AGENTIC SCHOLAR</span><span>AGENTS / TOOLS / RL</span></div>
  <div class="agent-stage-layout">
    <div class="stage-story" data-reveal><h2 id="agents-heading" class="stage-display">AGENTIC<br/><span>SCHOLAR</span></h2><p class="stage-intro">Agent 系统与相关研究</p><p class="stage-description">工具协议、世界模型与多轮交互。<br/>整理相关论文、项目和阅读记录。</p><a href="/agentic-scholar/" class="stage-button">进入 Agentic Scholar <span aria-hidden="true">↗</span></a></div>
    <div class="agent-trajectory" data-agent-demo aria-label="Agent 交互轨迹示意">
      <div class="trajectory-label"><span>AGENT TRAJECTORY</span><span>交互示意</span></div>
      <SpatialScene variant="agents" label="Agent 轨迹" theme="orange" />
      <div class="trajectory-core" aria-live="polite"><span class="trajectory-step" data-agent-number>01</span><div><strong data-agent-title>接收任务</strong><p data-agent-detail>修复一个失败的单元测试。</p></div></div>
      <div class="trajectory-controls" role="group" aria-label="查看轨迹步骤">{['任务','动作','观察','验证'].map((label,i)=><button data-agent-step={i} aria-pressed={i===0?'true':'false'}><span>0{i+1}</span>{label}</button>)}</div>
      <button class="trajectory-next" data-agent-next>回放下一步 <span aria-hidden="true">→</span></button>
    </div>
  </div>
  <div class="agent-keywords" aria-hidden="true"><span>POLICY</span><i>↗</i><span>ENVIRONMENT</span><i>↗</i><span>FEEDBACK</span><i>↗</i><span>POLICY</span></div>
</section>

<section id="algorithm" class="home-algorithms stage-shell" aria-labelledby="algorithm-stage-heading" data-home-stage>
  <div class="stage-meta"><span>03 / ALGORITHM</span><span>PERSONAL NOTES · CSDN</span></div>
  <h2 id="algorithm-stage-heading" class="algorithm-stage-title" data-reveal>ALGORITHM<span aria-hidden="true">↗</span></h2>
  <div class="algorithm-stage-layout">
    <SortingScene />
    <div class="algorithm-stage-notes"><p class="stage-intro">算法题解与学习笔记。<br/>原文发布在 CSDN。</p><div class="algorithm-preview-list">{notes.map((note,i)=><a href={note.url} target="_blank" rel="noreferrer"><small>0{i+1} / {note.tags[0]}</small><span>{note.title}</span><b aria-hidden="true">↗</b></a>)}</div><a class="stage-button" href="/algorithms/">阅读全部 {algorithmArticles.length} 篇笔记 <span aria-hidden="true">↗</span></a></div>
  </div>
</section>

<script>
  import { initHomeStages } from '../../scripts/home-stages';
  initHomeStages();
</script>
