---
const cells = [[3,3],[4,4],[5,5],[2,5],[3,5],[4,3],[5,3],[3,4],[2,3]];
---
<section id="tools" class="home-playground stage-shell" aria-labelledby="playground-heading">
  <div class="stage-meta"><span>05 / TOOLS</span><a href="/tools/">ALL SEVEN TOOLS ↗</a></div>
  <div class="playground-heading" data-reveal><h2 id="playground-heading">TOOLS</h2><p>五子棋、图像处理<br/>与实用工具。</p></div>
  <div class="playground-exhibits">
    <a class="playground-piece piece-gomoku" href="/tools/gomoku"><div class="piece-art"><svg viewBox="0 0 300 300" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width=".65">{Array.from({length:9},(_,i)=><><path d={`M${30+i*30} 30v240`}/><path d={`M30 ${30+i*30}h240`}/></>)}</g>{cells.map(([x,y],i)=><circle cx={30+x*30} cy={30+y*30} r="12.5" fill={i%2===0?'#282828':'#e8e5df'} stroke="#282828" stroke-width=".7"/>)}</svg><span class="piece-open" aria-hidden="true">↗</span></div><div class="piece-caption"><span>01 / STRATEGY</span><h3>五子棋<small>Gomoku</small></h3></div></a>
    <div class="playground-piece piece-beautifier"><a href="/tools/beautifier" aria-label="打开图像工作台"><div class="piece-art"><img src="/images/hero/adventure-light-mobile.webp" alt="" loading="lazy" width="960" height="447"/><div class="beautifier-split"></div><span class="beautifier-before">BEFORE</span><span class="beautifier-after">AFTER</span><span class="piece-open" aria-hidden="true">↗</span></div></a><label class="comparison-control"><span>拖动对比</span><input type="range" min="2" max="98" value="50" data-comparison aria-label="图像前后对比"/><output>50%</output></label><a class="piece-caption" href="/tools/beautifier"><span>02 / CREATE</span><h3>图像工作台<small>Beautifier</small></h3></a></div>
    <a class="playground-piece piece-mail" href="/tools/tempmail"><div class="piece-art"><span class="mail-art" aria-hidden="true">@</span><span class="piece-open" aria-hidden="true">↗</span></div><div class="piece-caption"><span>03 / UTILITY</span><h3>临时邮箱<small>TempMail</small></h3></div></a>
  </div>
</section>
