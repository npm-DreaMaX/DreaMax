<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.portfolio-section-nav a');
  const observer = new IntersectionObserver(entries=>entries.forEach(entry=>{
    if(entry.isIntersecting) links.forEach(link=>{ const current=link.hash==='#'+entry.target.id; link.classList.toggle('current',current); if(current)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current'); });
  }),{rootMargin:'-20% 0px -60% 0px'});
  links.forEach(a=>{const target=document.querySelector(a.hash);if(target)observer.observe(target);});
</script>
