---
import Wordmark from "../ui/Wordmark.astro";
import { algorithmArticles } from '../../data/algorithms';
import { papers } from '../../../fieldwork/src/data/readings';
import { tools } from '../../data/experience';
import { navigation } from '../../data/navigation';
import { featuredProjects, featuredResearch } from '../../data/featured';
const pathname = Astro.url.pathname;
const active = (href:string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const routes = [
  { title: '预训练', en:'PRETRAINING', href:'/fieldwork/paths/pretraining', description:'数据、MoE、预算与训练稳定性' },
  { title: '中训练', en:'MID-TRAINING', href:'/fieldwork/paths/midtraining', description:'长上下文、能力塑形与阶段接口' },
  { title: '后训练', en:'POST-TRAINING', href:'/fieldwork/paths/posttraining', description:'SFT、偏好与推理强化学习' },
  { title: 'Agentic RL', en:'AGENTIC RL', href:'/fieldwork/paths/agentic', description:'环境、长轨迹与异步 rollout' },
  { title: '算子与集群', en:'SYSTEMS', href:'/fieldwork/paths/systems', description:'GPU、显存、带宽与通信' },
];
const index = [
  ...algorithmArticles.map(a=>({title:a.title,description:a.description,category:"我的算法笔记",href:a.url,keywords:a.tags.join(" ")})),
  ...navigation.map(n => ({title:n.label,description:n.description,category:'栏目',href:n.href,keywords:n.short})),
  ...featuredProjects.map(p=>({title:p.title,description:p.description,category:'我的项目',href:p.link,keywords:p.tags.join(' ')})),
  ...papers.map(p => ({ title:p.title,description:p.subtitle,category:'论文精读',href:`/fieldwork/papers/${p.id}`,keywords:p.tags.join(' ') })),
  ...tools.map(t => ({ title:t.title+' '+t.zh,description:t.description,category:'工具',href:t.href,keywords:t.category })),
  ...routes.map(r=>({title:r.title,description:r.description,category:'阅读路线',href:r.href,keywords:r.en})),
  ...featuredResearch.map(r=>({title:r.title,description:r.description,category:'Selected Research',href:r.link,keywords:r.venue})),
];
---
<header class="dm-header" data-command-header>
  <a href="/" class="dm-brand" aria-label="DreaMax 首页"><Wordmark /></a>
  <nav class="dm-primary-nav" aria-label="主导航">
    <div class="dm-learning-nav">
      <a href="/llm-training/" class:list={{active:pathname.startsWith('/llm-training')}} aria-current={pathname.startsWith('/llm-training')?'page':undefined}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 2 8 8-8 8-8-8Z"/><path d="M2 10h16M10 2v16"/></svg>LLM Training</a>
      <button data-training-toggle aria-controls="dm-training-menu" aria-expanded="false" aria-label="展开 LLM Training 学习路线"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></button>
    </div>
    <a href="/agentic-scholar/" class:list={{active:active('/agentic-scholar/')}} aria-current={active('/agentic-scholar/')?'page':undefined}><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="4" r="2"/><circle cx="4" cy="15" r="2"/><circle cx="16" cy="15" r="2"/><path d="m9 6-4 7m6-7 4 7M6 15h8"/></svg>Agentic Scholar</a>
    <a href="/algorithms/" class:list={{active:active('/algorithms/')}} aria-current={active('/algorithms/')?'page':undefined}>Algorithm</a>
    <a href="/#projects" data-project-nav><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="6" width="15" height="11.5" rx="2"/><path d="M6 6V3h8v3M3 10h14"/></svg>Projects</a>
    <a href="/tools/" class:list={{active:active('/tools/')}} aria-current={active('/tools/')?'page':undefined}><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="5" height="5" rx="1"/><rect x="12" y="3" width="5" height="5" rx="1"/><rect x="3" y="12" width="5" height="5" rx="1"/><path d="M14.5 11v7M11 14.5h7"/></svg>Tools</a>
  </nav>
  <div class="dm-header-actions">
    <a class="dm-mobile-training" href="/llm-training/">LLM Training <span>↗</span></a>
    <button class="dm-search-trigger" data-open-search aria-label="搜索全站"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><kbd>⌘K</kbd></button>
    <button class="dm-menu-trigger" data-open-menu aria-haspopup="dialog" aria-controls="dm-menu" aria-label="打开全站导航"><span>Menu</span><i aria-hidden="true"></i></button>
  </div>
  <section id="dm-training-menu" class="dm-training-menu" aria-label="LLM Training 快捷导航" hidden>
    <a href="/llm-training/" class="dm-training-feature"><span class="dm-flyout-eyebrow">LLM TRAINING</span><strong>Training<br/>methods.</strong><p>论文精读、源码导读<br/>与训练实验。</p><span class="dm-flyout-link">进入 LLM Training <b>↗</b></span><svg viewBox="0 0 180 180" class="dm-flyout-art" fill="none" aria-hidden="true">{[0,1,2,3,4,5].map(i=><ellipse cx="90" cy="90" rx="70" ry={18+i*9} transform={`rotate(${i*24} 90 90)`}/>)}</svg></a>
    <div class="dm-training-links"><span class="dm-flyout-eyebrow">CHOOSE YOUR STARTING POINT</span>{routes.map((r,i)=><a href={r.href}><span class="dm-path-number">0{i+1}</span><span><strong>{r.title}</strong><small>{r.description}</small></span><span aria-hidden="true">↗</span></a>)}<div class="dm-training-extras"><a href="/fieldwork/papers">论文书架 ↗</a><a href="/fieldwork/labs">交互实验 ↗</a><a href="/fieldwork/notebook">我的阅读 ↗</a></div></div>
  </section>
</header>
<dialog id="dm-menu" class="dm-menu-dialog" aria-labelledby="dm-menu-heading">
  <div class="dm-dialog-top"><a href="/" class="dm-brand"><Wordmark /></a><span class="dm-menu-top-note">SITE NAVIGATION</span><button class="dm-close" data-close-dialog aria-label="关闭导航">关闭 <span aria-hidden="true">×</span></button></div>
  <div class="dm-menu-content">
    <nav class="dm-menu-main" aria-labelledby="dm-menu-heading">
      <p id="dm-menu-heading" class="dm-eyebrow">THE INDEX / DREAMAX</p>
      {navigation.map((n,i) => <a href={n.href} aria-current={active(n.href)?'page':undefined} data-nav-preview={n.description} data-nav-number={`0${i+1}`}><sup>0{i+1}</sup><span>{n.label}</span><span aria-hidden="true">↗</span></a>)}
    </nav>
    <div class="dm-menu-secondary">
      <div class="dm-menu-map" aria-hidden="true"><span class="dm-menu-map-number" data-nav-preview-number>02</span><div class="dm-menu-orbits"><i></i><i></i><i></i></div><span class="dm-menu-map-coordinate">D / M</span></div>
      <p class="dm-nav-preview" data-nav-preview-description>论文精读、训练路线与交互实验</p>
      <div class="dm-menu-paths"><p class="dm-eyebrow">INSIDE LLM TRAINING</p>{routes.map((r,i)=><a href={r.href}><span><small>0{i+1}</small>{r.title}</span><span aria-hidden="true">↗</span></a>)}</div>
      <div class="dm-menu-shortcuts"><a href="/fieldwork/notebook">我的阅读 ↗</a><a href="/#projects">开源项目 ↗</a><a href="https://github.com/npm-DreaMaX" target="_blank" rel="noreferrer">GitHub ↗</a></div>
    </div>
  </div>
  <div class="dm-menu-bottom"><span>DreaMax</span><a href="mailto:3752703718@qq.com">CONTACT ↗</a></div>
</dialog>
<dialog id="dm-search" class="dm-search-dialog" aria-labelledby="dm-search-heading">
  <div class="dm-search-top"><label id="dm-search-heading" for="dm-search-input">搜索全站</label><button class="dm-close" data-close-dialog aria-label="关闭搜索">Esc <span aria-hidden="true">×</span></button></div>
  <input id="dm-search-input" type="search" placeholder="项目、论文、训练路线或工具…" autocomplete="off" />
  <p id="dm-search-count" class="dm-eyebrow" aria-live="polite">精选入口</p>
  <div id="dm-search-results"></div>
  <p class="dm-search-hint">方向键选择 · Enter 打开 · Esc 返回</p>
</dialog>
<script type="application/json" id="dm-search-data" set:html={JSON.stringify(index).replaceAll('<','\u003c')}></script>
