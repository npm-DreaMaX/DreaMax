---
import '@fontsource/orbitron/700.css';
import '@fontsource/audiowide/400.css';
const lines = ['A website', 'for everyone', 'to learn and'];
const words = ['Change', 'The', 'World'];
let letterIndex = 0;
---
<div id="ts-wrap" class="ts-wrap" data-terminal-slogan>
  <div class="ts-intro" aria-label="A website for everyone to learn and">
    {lines.map(line => <div class="ts-row" aria-hidden="true">{line.split(' ').map(word => <span class="ts-block">{word}</span>)}</div>)}
  </div>
  <button id="cw-line" class="ts-world" type="button" aria-label="Change The World — 点击重播跳动文字" title="点击，让文字再跳一次">
    {words.map(word => <span class="ts-world-word" aria-hidden="true">{[...word].map(letter => <span class="cl" style={`--letter-color:${['#ff712e','#f5f3ef','#ffad80'][letterIndex++ % 3]}`}>{letter}</span>)}</span>)}
  </button>
</div>
<script>
  import { initTerminalSlogan } from '../../scripts/terminal-slogan';
  const host = document.querySelector<HTMLElement>('[data-terminal-slogan]');
  if (host) initTerminalSlogan(host);
</script>
<style>
  .ts-wrap { position:relative; width:max-content; max-width:100%; z-index:2; user-select:none; text-align:right; }
  .ts-row { display:flex; gap:6px; justify-content:flex-end; margin-bottom:4px; }
  .ts-block { display:inline-block; padding:3px 8px; border-radius:4px; font:700 clamp(12px,1.1vw,17px)/1.55 'Orbitron',monospace; color:#ebe8e1; background:#ebe8e112; border:1px solid #ebe8e12b; letter-spacing:1px; }
  .ts-world { display:flex; align-items:center; justify-content:flex-end; gap:.45em; min-height:44px; padding:8px 0; margin-top:5px; border:0; background:none; cursor:pointer; }
  .ts-world-word { display:inline-flex; white-space:nowrap; }
  .cl { display:inline-block; font:400 clamp(20px,1.7vw,30px)/1.3 'Audiowide',cursive; color:var(--letter-color); text-shadow:0 0 8px color-mix(in srgb,var(--letter-color) 18%,transparent),0 0 25px color-mix(in srgb,var(--letter-color) 8%,transparent); letter-spacing:.5px; }
  .ts-world:focus-visible { outline:2px solid #c8b99f; outline-offset:5px; border-radius:3px; }
  @media(max-width:1199px) { .ts-block { font-size:12px; }.cl { font-size:24px; } }
  @media(max-width:760px) { .ts-wrap { text-align:left; }.ts-row,.ts-world { justify-content:flex-start; }.ts-block { font-size:11px; padding:2px 7px; }.ts-row { margin-bottom:3px; }.ts-world { margin-top:2px; padding:5px 0; }.cl { font-size:23px; } }
</style>
