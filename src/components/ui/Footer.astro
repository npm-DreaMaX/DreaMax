---
import Wordmark from "./Wordmark.astro";
import { profile } from '../../data/profile';
---
<footer class="dm-footer">
  <div class="dm-footer-top dm-container">
    <div><p class="dm-eyebrow">CONTACT</p><a class="dm-footer-invitation" href={`mailto:${profile.email}`}>联系 DreaMax<span aria-hidden="true">↗</span></a></div>
    <div class="dm-footer-links"><a href="/fieldwork/">Fieldwork</a><a href="/tools/">工具</a><a href="/join/">关于 DreaMax</a><a href={profile.social.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={profile.social.csdn} target="_blank" rel="noreferrer">CSDN ↗</a></div>
  </div>
  <div class="dm-footer-bottom dm-container"><a href="/" class="dm-brand"><Wordmark /></a><p>{profile.title}</p><span>© {new Date().getFullYear()} DreaMax</span><a href="#main-content" aria-label="回到顶部">BACK TO TOP ↑</a></div>
</footer>
