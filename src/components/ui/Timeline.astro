---
import type { TimelineEntry } from "../../data/timeline";
interface Props { entries: TimelineEntry[]; max?: number; }
const { entries, max } = Astro.props;
const display = max ? entries.slice(0, max) : entries;
---

{display.length > 0 && (
  <div class="relative space-y-6 pl-8 before:absolute before:left-3 before:top-2 before:h-[calc(100%-1rem)] before:w-px before:bg-white/8">
    {display.map((entry) => (
      <div class="relative">
        <div class="absolute -left-[1.65rem] top-1.5 h-2.5 w-2.5 rounded-full border border-[#ff6b2b] bg-[#0a0a0a]" />
        <time class="block font-mono text-xs text-white/25">{entry.date}</time>
        <p class="mt-1 text-sm text-white/80">{entry.link ? <a href={entry.link}>{entry.title} ↗</a> : entry.title}</p>
        <p class="text-xs text-white/35">{entry.description}</p>
      </div>
    ))}
  </div>
)}
